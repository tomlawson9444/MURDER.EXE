{
  "name": "murder-exe",
  "productName": "MURDER.EXE",
  "version": "0.1.0",
  "description": "MURDER.EXE desktop build for Steam: the browser game in Electron, with Steam achievements through steamworks.js.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "game": "node copy-game.js",
    "start": "npm run game && electron .",
    "dist": "npm run game && electron-builder --win --linux"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.murderexe.game",
    "productName": "MURDER.EXE",
    "files": ["main.js", "preload.js", "game/**"],
    "asarUnpack": ["node_modules/steamworks.js/dist/**"],
    "directories": { "output": "dist" },
    "win": { "target": "dir" },
    "linux": { "target": "dir" }
  }
}
