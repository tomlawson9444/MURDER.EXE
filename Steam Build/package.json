{
  "name": "murder-exe",
  "productName": "MURDER.EXE",
  "version": "0.1.0",
  "description": "MURDER.EXE desktop build for Steam: the browser game in Electron, with Steam achievements through steamworks.js.",
  "author": "MURDER.EXE",
  "repository": "github:tomlawson9444/MURDER.EXE",
  "main": "main.js",
  "steamAppId": 480,
  "private": true,
  "scripts": {
    "game": "node copy-game.js",
    "start": "npm run game && electron .",
    "smoke": "npm run game && cross-env MURDER_SMOKE=1 MURDER_WINDOWED=1 electron .",
    "dist:win": "npm run game && electron-builder --win dir",
    "dist:linux": "npm run game && electron-builder --linux dir",
    "dist:mac": "npm run game && electron-builder --mac dir",
    "dist": "npm run game && electron-builder --win dir --linux dir",
    "set-app-id": "node tools/set-app-id.js"
  },
  "dependencies": {
    "steamworks-ffi-node": "^0.11.3"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.murderexe.game",
    "productName": "MURDER.EXE",
    "files": [
      "main.js",
      "steam.js",
      "preload.js",
      "game/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/steamworks-ffi-node/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "murder-exe"
    },
    "icon": "build/icon.png",
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.action-games"
    },
    "extraResources": [
      {
        "from": "steamworks_sdk",
        "to": "steamworks_sdk",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "./tools/linux-launcher.js"
  }
}
